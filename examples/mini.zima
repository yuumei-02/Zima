import "./include_able.zima"

def scopes():
   scope:
      return 40
   scope "named scope":
      return 90

def empty() -> int:
   return 1

def add(a: int, b: int) -> int:
   result: int = a + b
   return result

def main():
   val: int = add(1, 2)
   msg: str : "Zhyivannye miratte"

class Vec2:
   x: int
   y: int

   def __init__(self, x: int, y: int):
      self.x = x
      self.y = y

   def area(self) -> int:
      area: int = self.x * self.y
      return area
