// This file is an example for file inclusion in other example files.

class Vec3:
   x: int
   y: int
   z: int
   
   def __init__(self, x: int, y: int, z: int) -> None:
      self.x = x
      self.y = y
      self.z = z
      
   def area(self) -> int:
      return self.x * self.y * self.z
